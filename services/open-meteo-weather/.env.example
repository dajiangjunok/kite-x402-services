PAY_TO=0xYourKiteWalletAddress
KITE_NETWORK=testnet
# Paid proxying requires a commercial subscription. /v1 is the upstream base path.
UPSTREAM_URL=https://customer-api.open-meteo.com/v1
OPEN_METEO_API_KEY=
PRICE_USD=0.001
UPSTREAM_TIMEOUT_MS=15000
# Optional authentication for a licensed, self-hosted upstream:
UPSTREAM_AUTH_HEADER=Authorization
UPSTREAM_AUTH_VALUE=
FACILITATOR_URL=https://facilitator.pieverse.io/v2
SERVICE_DESCRIPTION="Open-Meteo weather forecast (hourly/daily) for any coordinate"
PORT=8080
